# All values are public build-time settings (they end up in the HTML).
# Never put secrets here.

# Contact email shown on /contact. Must be a real address you control.
VITE_CONTACT_EMAIL=

# Google Search Console HTML-tag verification token (content="..." value only).
VITE_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4. The CreatorKit stream ID (G-WPEHRBK1Q4) is built in
# (src/config/site.ts); set this only to override it. VITE_GA=false builds
# without Google Analytics.
VITE_GA_MEASUREMENT_ID=
VITE_GA=

# AdSense: leave empty until CreatorKit is added to YOUR AdSense account.
# Format: ca-pub-0000000000000000
VITE_ADSENSE_CLIENT=
# Set to "true" only after the site is approved AND a certified consent
# message (e.g. Google's CMP) is published for EEA/UK/Swiss visitors.
VITE_ADS_ENABLED=false
# Ad unit slot ID created in AdSense (Ads > By ad unit > Display ads).
VITE_ADSENSE_SLOT=
